# ═══════════════════════════════════════════════════════════
# IQA Finance Portal — Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in actual values.
# NEVER commit .env to source control.
# ═══════════════════════════════════════════════════════════

# Server
NODE_ENV=development
PORT=3001
SERVER_PORT=3001

# Session — REQUIRED in production (min 32 chars, random)
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHAR_STRING
SESSION_SECURE_COOKIE=false
SESSION_SAMESITE=lax
SESSION_IDLE_TIMEOUT_MIN=30
SESSION_ABSOLUTE_LIFETIME_HR=8

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Login Protection
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MIN=15
LOGIN_RATE_WINDOW_MIN=15
LOGIN_RATE_MAX=10

# Password Policy
PASSWORD_MIN_LENGTH=12

# MFA
MFA_ISSUER=IQA Finance Portal
MFA_MAX_ATTEMPTS=3

# Rate Limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=200
AUTH_RATE_WINDOW_MIN=15
AUTH_RATE_MAX=10
SENSITIVE_RATE_WINDOW_MS=60
SENSITIVE_RATE_MAX=5

# Password Reset
RESET_TOKEN_EXPIRY_MIN=30

# Invitation
INVITE_TOKEN_EXPIRY_HR=72

# Initial Admin Credentials (ONLY for first-time seed)
# Change immediately after first login
INITIAL_ADMIN_PASSWORD=Admin@SecureP0rtal!
INITIAL_FINANCE_PASSWORD=Finance@SecureP0rtal!
